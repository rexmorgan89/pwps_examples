  let PREVIEW_LOOKUP = {"d1e3": {"l": "topics/PWPS_Cloud_Readme/c-Notices.html#GUID-C6A0C356-1062-4ABF-9B05-544AD530B97E","t": "Notices","d": "<div class=\"abstract\"><p class=\"shortdesc\">TRADEMARK NOTICE Bentley and the B Bentley logo are registered or non-registered trademarks of Bentley Systems, Incorporated. All other marks are the property of their respective owners. COPYRIGHT NOTICE Copyright (c) 2026 Bentley Systems, Incorporated. All rights reserved....</p></div>"},"d1e10": {"l": "topics/PWPS_Cloud_Readme/c_pwps-new_2026.html#whats-new-in-pwps-cloud-2025","t": "What’s New in PWPS_Cloud 2026","d": "<div class=\"abstract\"><p class=\"shortdesc\"></p></div>"},"d1e17": {"l": "topics/PWPS_Cloud_Readme/c_pwps_cloud_readme_security_release_notes.html#pwps_cloud_readme_security_release_notes","t": "Security Release Notes","d": "<div class=\"abstract\"><p class=\"shortdesc\">Not applicable to this release.</p></div>"},"d1e24": {"l": "topics/PWPS_Cloud_Readme/c_pwps_excluded_cmdlets.html#discontinued-cmdlets","t": "Excluded Cmdlets","d": "<div class=\"abstract\"><p class=\"shortdesc\">The following cmdlets are unavailable in PWPS_Cloud: Cmdlet Origin Notes Add-PDFQRCode PWPS_DAB Not in the scope of PWPS_Cloud. Add-PDFWatermarkText PWPS_DAB Not in the scope of PWPS_Cloud. Add-PW365Project PWPS_DAB Replaced by CloudProject cmdlets for Bentley Infrastructur...</p></div>"},"d1e31": {"l": "topics/PWPS_Cloud_Readme/c_pwps_getting_started.html#getting_started","t": "Getting Started","d": "<div class=\"abstract\"><p class=\"shortdesc\">Visit Microsoft PowerShell Gallery and install the PWPS_Cloud module using the following command: Install-Module -Name PWPS_Cloud You can install and use PWPS, PWPS_DAB, and PWPS_Cloud modules on the same machine, enabling a phased migration path. This allows you to continu...</p></div>"},"d1e39": {"l": "topics/PWPS_Cloud_Readme/c_pwps_included_cmdlets.html#included-cmdlets","t": "Included Cmdlets","d": "<div class=\"abstract\"><p class=\"shortdesc\">The following cmdlets are available in PWPS_Cloud: Cmdlets Included in PWPS_Cloud Cmdlet Included in Version Origin Compatibility notes Add-CloudProject 26.0.0 PWPS_DAB Add-PWDocumentsWithCode 26.0.0 PWPS_DAB Add-PWGroupMember 26.0.0 PWPS Add-PWUserDynamicCreationFilter 26....</p></div>"},"d1e46": {"l": "topics/PWPS_Cloud_Readme/c_pwps_introduction.html#introduction","t": "Introduction","d": "<div class=\"abstract\"><p class=\"shortdesc\">ProjectWise PowerShell Cloud (PWPS_Cloud) is a unified PowerShell module for ProjectWise administration and scripting that combines and extends the capabilities of the PWPS and PWPS_DAB modules. The module is optimized for and provides full compatibility with ProjectWise Cl...</p></div>"},"d1e53": {"l": "topics/PWPS_Cloud_Readme/c_pwps_list_of_pwps_cloud_cmdlets.html#list-of-pwps-cloud-cmdlets","t": "List of PWPS_Cloud Cmdlets","d": "<div class=\"abstract\"><p class=\"shortdesc\">Refer to the following topics to view an exhaustive list of included and excluded cmdlets:</p></div>"},"d1e60": {"l": "topics/PWPS_Cloud_Readme/c_pwps_migration_for_pwps_dab_users.html#new-in-pwps-cloud-202501","t": "Migration Guidance for PWPS_DAB Users","d": "<div class=\"abstract\"><p class=\"shortdesc\">PWPS_DAB is not fully compatible with ProjectWise Cloud, and it is entirely incompatible with ProjectWise Cloud when you enable Enhanced Security Mode. PWPS_DAB users running against ProjectWise Cloud are therefore encouraged to migrate their scripts to PWPS_Cloud. The curr...</p></div>"},"d1e67": {"l": "topics/PWPS_Cloud_Readme/c_pwps_migration_for_pwps_users.html#notes-to-pwps-dab-users","t": "Migration Guidance for PWPS Users","d": "<div class=\"abstract\"><p class=\"shortdesc\">PWPS_Cloud module includes all cmdlets from the current PWPS module. It is fully backward-compatible, with only minor changes listed in the following: Login/Logout cmdlets: Use New-PWLogin instead of Open-PWConnection. Use Undo-PWLogin instead of Close-PWConnection. User an...</p></div>"},"d1e74": {"l": "topics/PWPS_Cloud_Readme/c_pwps_new_in_pwps_cloud_2026_0_1.html#new_in_pwps_cloud_2026_0_1","t": "New in PWPS_Cloud 2026.0.1","d": "<div class=\"abstract\"><p class=\"shortdesc\">Updated Documentation The Getting Started section of this document was updated with additional information on using the PWPS_Cloud module alongside other ProjectWise modules. New Cmdlets This release includes these new cmdlets: Get-PWDocumentsBySearch Get-PWDocumentsBySearc...</p></div>"},"d1e82": {"l": "topics/PWPS_Cloud_Readme/c_pwps_new_in_pwps_cloud_26_0_0.html#new_in_pwps_cloud_26_0_0","t": "New in PWPS_Cloud 2026.0.0","d": "<div class=\"abstract\"><p class=\"shortdesc\">This first release introduces a unified module that combines cmdlets from PWPS with an initial subset of cmdlets from PWPS_DAB. Included Cmdlets All cmdlets from the current PWPS module (with minor adjustments). Initial set of essential cmdlets based on the PWPS_DAB library...</p></div>"},"d1e89": {"l": "topics/PWPS_Cloud_Readme/c_pwps_readme.html#c_pwps_cloud_installation","t": "PWPS_Cloud PowerShell Module Readme","d": "<div class=\"abstract\"><p class=\"shortdesc\"></p></div>"},"d1e96": {"l": "topics/PWPS_Cloud_Readme/c_pwps_system_requirements.html#system_requirements","t": "System Requirements","d": "<div class=\"abstract\"><p class=\"shortdesc\">PowerShell: Windows PowerShell 5.1 or later. Server Compatibility: ProjectWise Design Integration 2023 and later. ProjectWise Client: Version compatible with the server.</p></div>"},"d1e103": {"l": "topics/PWPS_Cloud_Readme/c_pwps_using_with_other_ps_modules.html#c_troubleshooting","t": "Using PWPS_Cloud Alongside PWPS and PWPS_DAB Modules","d": "<div class=\"abstract\"><p class=\"shortdesc\">PWPS_Cloud has cmdlets that overlap with PWPS and PWPS_DAB modules. This introduces a risk that a cmdlet from another module will be invoked by mistake. To avoid command resolution conflicts, Bentley recommends using only one PowerShell module per PowerShell session wheneve...</p></div>"}};
  const scripts = document.getElementsByTagName("script");
  const scriptPath = scripts[scripts.length - 1].src;
  const JSON_PATH = scriptPath.substr(0, scriptPath.lastIndexOf("/") + 1);
  const BASE_URL = scriptPath.substr(
    0,
    JSON_PATH.lastIndexOf("/", JSON_PATH.lastIndexOf("/") - 1) + 1
  );

  function jsonFetch(json, filename) {
    return new Promise(function (resolve, reject) {
      if (json) {
        return resolve(json);
      }

      fetch(JSON_PATH + filename)
        .then((response) => {
          if (!response.ok) {
            return reject(new Error(`HTTP error, status = ${response.status}`));
          }
          return response.json();
        })
        .then((data) => {
          return resolve(data);
        });
    });
  }

  // Parse search results into HTML
  function parseLunrResults(results) {
    const html = [];
    for (let i = 0; i < results.length; i++) {
      const id = results[i]["ref"];
      const item = PREVIEW_LOOKUP[id];
      const title = item["t"];
      const preview = item["d"];
      const link = item["l"];
      const result = `<div class="card mb-3 search-close">
        <a class="link stretched-link link-underline link-underline-opacity-0" href="${BASE_URL + link}">
            <h2 class="h3 title card-header text-body-emphasis">${title}</h5>
        </a>
        <div class="card-body">
          <div class="card-text">
            ${preview}
          </div>
        </div>
      </div>`;
      html.push(result);
    }
    if (html.length) {
      return html.join("");
    } else {
      return "<p>Your search returned no results</p>";
    }
  }

  function formatResults(results) {
    return `<article role="article">
        <div class="modal-header justify-content-between">
            <h1>Search Results</h1>
            <button type="button" class="btn-close search-close" aria-label="Close"/>
        </div>
        <div class="modal-body">
      ${parseLunrResults(results)}
      </div>
      </article>`;
  }

  function escapeHtml(unsafe) {
    return unsafe
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function closeSearch(el) {
    const elements = document.getElementsByClassName("bs-main");
    elements[1].remove();
    elements[0].classList.remove("collapse");
    return false;
  }

  function search(query) {
    Promise.all([
      jsonFetch(LUNR_DATA, "search_index.json"),
      jsonFetch(PREVIEW_LOOKUP, "preview.json"),
    ])
      .then((values) => {
        LUNR_DATA = values[0];
        PREVIEW_LOOKUP = values[1];
        const idx = lunr.Index.load(LUNR_DATA);
        // Write results to page
        const results = idx.search(query);
        const elements = document.getElementsByClassName("bs-main");

        if (elements.length < 2) {
          const resultHtml = `<main role="main" class="container bs-main">
            ${formatResults(results)}</main>`;

          elements[0].insertAdjacentHTML("afterend", resultHtml);
        } else {
          elements[1].innerHTML = formatResults(results);
        }

        elements[0].classList.add("collapse");
        window.scrollTo(0, 0);
        const closeBox = document.getElementsByClassName("search-close");
        for(let i = 0; i < closeBox.length; i++) {
           closeBox[i].addEventListener("click", closeSearch);
        }
        return false;
      })
      .catch((e) => {
        console.log(e);
      });
    return false;
  }

  window.addEventListener('load', function() {
    const elements = document.getElementsByClassName("search-box");
    for(let i = 0; i < elements.length; i++) {
      elements[i].addEventListener("submit", (e) =>{
        e.preventDefault();
        search(e.target.querySelectorAll('*[type="search"]')[0].value);
        return false;
      },false);
    }
  });
})();
