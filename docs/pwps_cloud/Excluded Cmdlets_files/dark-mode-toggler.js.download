        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } // Scroll to the top of the page

        function scrollToProductSection() {
            document.getElementsByClassName('product-section')[0].scrollIntoView({ behavior: 'smooth' });
        } // Scroll to the product section

        window.addEventListener('scroll', function () {
            const newFooter = document.querySelector('.new-footer');
            const footer = document.querySelector('footer');
            const footerRect = footer.getBoundingClientRect();
            const windowHeight = window.innerHeight;

            if (footerRect.top <= windowHeight) {
                newFooter.style.bottom = `${windowHeight - footerRect.top}px`;
            } else {
                newFooter.style.bottom = '0';
            } // Both of the two footers appear when scroll is at the very bottom
        });
  </script>
