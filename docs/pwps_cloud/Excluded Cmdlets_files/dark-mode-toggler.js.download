   <!-- AI Transparency section -->
   <div class="ai-transparency-section">
    <div class="ai-transparency-inner">
     <div class="ai-transparency-text">
      <h2 class="ai-transparency-title">
       AI Transparency
      </h2>
      <p class="ai-transparency-blurb">
       AI Transparency Cards give you a clear summary of the AI features in Bentley products. Each card explains what the feature does, how it works, and the safeguards that apply. You can read, bookmark, and share each page.
      </p>
      <a class="ai-transparency-button" href="/LiveContent/ai/index.html">
       Show cards
      </a>
     </div>
     <div aria-hidden="true" class="ai-transparency-preview">
      <div class="ai-preview-card">
       <div class="ai-preview-head">
        <span class="ai-preview-badge" style="--logo:url('/LiveContent/image/product_svg/AutoPIPE.svg')">
        </span>
        <span class="ai-preview-product">
         AutoPIPE
        </span>
       </div>
       <div class="ai-preview-feature">
        Bentley Copilot
       </div>
       <div class="ai-preview-desc">
        Help the user learn the software, search through documents and more
       </div>
       <div class="ai-preview-divider">
       </div>
       <div class="ai-preview-view">
        <span>
         View card
        </span>
        <span>
         →
        </span>
       </div>
      </div>
      <div class="ai-preview-card">
       <div class="ai-preview-head">
        <span class="ai-preview-badge" style="--logo:url('/LiveContent/image/product_svg/Bentley Infrastructure Cloud.svg')">
        </span>
        <span class="ai-preview-product">
         Bentley Infrastructure Cloud
        </span>
       </div>
       <div class="ai-preview-feature">
        Media Indexing
       </div>
       <div class="ai-preview-desc">
