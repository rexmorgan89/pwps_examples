erCAD-v2026/ReadMe/en/index.html", "DisplayFlag": true}]}]}]}]}, {"DocProductName": "OpenFlows SewerGEMS", "GprId": "1244", "PikaFlag": false, "DocTypes": [{"DocType": "Help", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/04/30 16:41:00", "FullURL": "/LiveContent/web/OpenFlows%20SewerGEMS-v2026/Help/en/index.html", "DisplayFlag": true}]}]}]}, {"DocType": "ReadMe", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/10/06 15:43:25", "FullURL": "/LiveContent/web/OpenFlows%20SewerGEMS-v2026/ReadMe/en/index.html", "DisplayFlag": true}]}]}]}]}, {"DocProductName": "OpenFlows WaterGEMS", "GprId": "1249", "PikaFlag": false, "DocTypes": [{"DocType": "Help", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/04/30 19:31:13", "FullURL": "/LiveContent/web/OpenFlows%20WaterGEMS-v2026/Help/en/index.html", "DisplayFlag": true}]}]}]}, {"DocType": "ReadMe", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/10/06 15:18:15", "FullURL": "/LiveContent/web/OpenFlows%20WaterGEMS-v2026/ReadMe/en/index.html", "DisplayFlag": true}]}]}]}]}, {"DocProductName": "OpenFlows WaterCAD", "GprId": "1248", "PikaFlag": false, "DocTypes": [{"DocType": "Help", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/04/30 18:44:23", "FullURL": "/LiveContent/web/OpenFlows%20WaterCAD-v2026/Help/en/index.html", "DisplayFlag": true}]}]}]}, {"DocType": "ReadMe", "MajorVersions": [{"MajorVersion": "2026", "MinorVersions": [{"MinorVersion": "", "Languages": [{"LiveContentVersion": "", "LiveContentGUID": "", "Language": "English", "DocDisplayVersion": "2026", "UpdateDate": "2026/10/06 15:32:41", "FullURL": "/LiveContent/web/OpenFlows%20WaterCAD-v2026/ReadMe/en/index.html", "DisplayFlag": true}]}]}]}]}]}]}]};
        
        // Function to filter products based on PikaFlag
        function getProductsWithPikaFlag(products) {
            return products.filter(product => product.PikaFlag === true);
        }

        // Function to filter brands based on PikaFlag
        function getBrandsWithPikaFlag(productLines) {
            return productLines.flatMap(productLine =>
                productLine.Brands.filter(brand =>
                    brand.Products.some(product => product.PikaFlag === true)
                )
            );
        }

        // Function to populate the Brand dropdown
        function populateBrandDropdown(brands) {
            brandSelect.innerHTML = '<option value="">Select a Brand</option>';
            // Sort brands alphabetically by their name
            brands.sort((a, b) => a.Brand.localeCompare(b.Brand));
            brands.forEach(brand => {
                const option = document.createElement('option');
                option.value = brand.Brand;
                option.textContent = brand.Brand;
                brandSelect.appendChild(option);
            });
        }

        // Function to populate the Product dropdown
        function populateProductDropdown(products) {
            productSelect.innerHTML = '<option value="">Select a Product</option>';
            // Sort products alphabetically by their name
            products.sort((a, b) => a.DocProductName.localeCompare(b.DocProductName));
            products.forEach(product => {
                const option = document.createElement('option');
                option.value = product.GprId;
                option.textContent = product.DocProductName;
                productSelect.appendChild(option);
            });
        }

        // Precompute all brands and products with PikaFlag set to true
        const allBrandsWithPikaFlag = getBrandsWithPikaFlag(data.ProductLines);
        const allProductsWithPikaFlag = data.ProductLines.flatMap(productLine =>
            productLine.Brands.flatMap(brand => getProductsWithPikaFlag(brand.Products))
        );  

        // Populate the Brand dropdown with filtered brands initially
        populateBrandDropdown(allBrandsWithPikaFlag);

        // Populate the Product dropdown with filtered products initially
        populateProductDropdown(allProductsWithPikaFlag);

        // Update Product dropdown when a Brand is selected
        brandSelect.addEventListener('change', () => {
            console.log("Brand selected:", brandSelect.value);
            const selectedBrand = brandSelect.value;

            if (selectedBrand) {
                // Filter products for the selected brand based on PikaFlag
                const selectedBrandData = data.ProductLines.flatMap(pl => pl.Brands)
                    .find(brand => brand.Brand === selectedBrand);

                if (selectedBrandData) {
                    const filteredProducts = getProductsWithPikaFlag(selectedBrandData.Products);
                    populateProductDropdown(filteredProducts);
                }
            } else {
                // Populate all products with PikaFlag filtering if no brand is selected
                populateProductDropdown(allProductsWithPikaFlag);
            }
        });

        // Call the function to populate the Brand dropdown and Product dropdown on page load
        document.addEventListener('DOMContentLoaded', () => {
            populateBrandDropdown(allBrandsWithPikaFlag);
            populateProductDropdown(allProductsWithPikaFlag);
        });
        console.log("DOM fully loaded and parsed");
  </script>
 </body>
</html>
