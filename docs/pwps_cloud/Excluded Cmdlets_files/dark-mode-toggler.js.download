       </div>
       <div class="ai-preview-divider">
       </div>
       <div class="ai-preview-view">
        <span>
         View card
        </span>
        <span>
         →
        </span>
       </div>
      </div>
      <div class="ai-preview-card">
       <div class="ai-preview-head">
        <span class="ai-preview-badge" style="--logo:url('/LiveContent/image/product_svg/iTwin Capture.svg')">
        </span>
        <span class="ai-preview-product">
